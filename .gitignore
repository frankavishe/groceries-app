# Root-level ignores for the monorepo. Each app (backend/admin-web/mobile-app)
# also has its own .gitignore for framework-specific artifacts.

node_modules/
dist/
build/
coverage/
backend/uploads/
*.log
.DS_Store
.idea/
.vscode/
.claude/

# env files
.env
.env.local
infra/.env
.env.example

# markdown docs — keep only README.md files tracked (PDF spec stays tracked too)
*.md
!README.md

# Terraform (infra/aws) — .tf definitions and .terraform.lock.hcl are
# tracked (the lock file pins provider versions, per HashiCorp's own
# guidance); the provider binary cache, state, and real-value vars are not.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
crash.log
crash.*.log
