# Copy to /infra/.env for local docker-compose, and to /backend/.env for the NestJS app.

# App
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=groceries
DB_PASSWORD=groceries
DB_NAME=groceries

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TOKEN_TTL=24h

# Africa's Talking (OTP/SMS) — leave blank in local dev to use the console OtpSenderPort
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# S3 (image uploads) — leave blank in local dev to use a local-disk stub
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment providers (sandbox credentials, filled in during Phase 9)
MPESA_API_KEY=
MIXX_YAS_API_KEY=
AIRTEL_MONEY_API_KEY=
